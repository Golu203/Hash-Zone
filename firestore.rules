rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public Catalog Data (readable by everyone) ─────────────────────────
    match /departments/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /categories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /subcategories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /products/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /hero_banners/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Settings & Configuration ───────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /systemSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /paymentConfig/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // ── Actual collections used by PaymentConfigService ──────────────────────
    match /paymentConfiguration/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /paymentInstructions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /paymentValidationSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /developerSettings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /websiteSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /adminSettings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Orders ─────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Customers can read/write their own orders; admins can read/write all
      allow read: if request.auth != null && (resource.data.customerId == request.auth.uid || request.auth.token.email.matches('.*@hashzone\\.com'));
      allow write: if request.auth != null && (request.auth.token.email.matches('.*@hashzone\\.com') || (resource != null && resource.data.customerId == request.auth.uid));
      allow create: if true; // allow unauthenticated order creation from checkout
    }

    // ── Payment Verifications ──────────────────────────────────────────────
    match /paymentVerifications/{docId} {
      allow read: if request.auth != null && (resource.data.customerId == request.auth.uid || request.auth.token.email.matches('.*@hashzone\\.com'));
      allow create: if true; // customers submit payment proofs
      allow update, delete: if request.auth != null && request.auth.token.email.matches('.*@hashzone\\.com');
    }

    // ── Customers ──────────────────────────────────────────────────────────
    match /customers/{uid} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || request.auth.token.email.matches('.*@hashzone\\.com'));
      match /addresses/{addrId} {
        allow read, write: if request.auth != null && (request.auth.uid == uid || request.auth.token.email.matches('.*@hashzone\\.com'));
      }
    }

    // ── Admin Users ────────────────────────────────────────────────────────
    match /adminUsers/{docId} {
      allow read: if request.auth != null && request.auth.token.email.matches('.*@hashzone\\.com');
      allow write: if request.auth != null && request.auth.token.email.matches('.*@hashzone\\.com');
    }

    // ── Backup & Recovery ─────────────────────────────────────────────────
    match /backups/{docId} {
      allow read, write: if request.auth != null && request.auth.token.email.matches('.*@hashzone\\.com');
    }

    // ── Order Sub-Collections ───────────────────────────────────────────────
    match /orderAudit/{docId} {
      allow read, write: if request.auth != null && request.auth.token.email.matches('.*@hashzone\\.com');
    }
    match /dispatchInformation/{docId} {
      allow read, write: if request.auth != null; // read is needed for order status check, write is admin only
      allow write: if request.auth != null && request.auth.token.email.matches('.*@hashzone\\.com');
    }
    match /refundInformation/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email.matches('.*@hashzone\\.com');
    }

    // ── Connection Status / System Health ─────────────────────────────────
    match /connectionStatus/{docId} {
      allow read, write: if request.auth != null;
    }
    match /systemHealth/{docId} {
      allow read, write: if request.auth != null;
    }

  }
}
