rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public Catalog Data (readable by everyone) ─────────────────────────
    match /departments/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /categories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /subcategories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /products/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /hero_banners/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Settings & Configuration ───────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /systemSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /paymentConfig/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // ── Actual collections used by PaymentConfigService ──────────────────────
    match /paymentConfiguration/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /paymentInstructions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /paymentValidationSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /developerSettings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /websiteSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /adminSettings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Orders ─────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Admins can read/write all orders
      allow read, write: if request.auth != null && request.auth.token.email.matches('.*@hashzone\\.(com|co\\.in)');
      // Customers can read their own orders
      allow read: if request.auth != null && resource.data.customerId == request.auth.uid;
      // Customers can create orders (write their own data)
      allow create: if true; // Allow checkout (both guest and authenticated customers)
      // Customers can update their own orders (e.g. payment proof update)
      allow update: if request.auth != null && resource.data.customerId == request.auth.uid;
    }

    // ── Payment Verifications ──────────────────────────────────────────────
    match /paymentVerifications/{docId} {
      allow read: if request.auth != null && (resource.data.customerId == request.auth.uid || request.auth.token.email.matches('.*@hashzone\\.(com|co\\.in)'));
      allow create: if true; // customers submit payment proofs
      allow update, delete: if request.auth != null && request.auth.token.email.matches('.*@hashzone\\.(com|co\\.in)');
    }

    // ── Customers ──────────────────────────────────────────────────────────
    match /customers/{uid} {
      // Owner or admin can read
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.email.matches('.*@hashzone\\.(com|co\\.in)'));
      // Owner can create their profile (right after sign-up, uid must match)
      allow create: if request.auth != null && request.auth.uid == uid;
      // Owner or admin can update
      allow update: if request.auth != null && (request.auth.uid == uid || request.auth.token.email.matches('.*@hashzone\\.(com|co\\.in)'));
      // Only admin can delete a customer profile
      allow delete: if request.auth != null && request.auth.token.email.matches('.*@hashzone\\.(com|co\\.in)');
      match /addresses/{addrId} {
        allow read, write: if request.auth != null && (request.auth.uid == uid || request.auth.token.email.matches('.*@hashzone\\.(com|co\\.in)'));
      }
    }

    // ── Admin Users ────────────────────────────────────────────────────────
    match /adminUsers/{docId} {
      allow read: if request.auth != null && request.auth.token.email.matches('.*@hashzone\\.(com|co\\.in)');
      allow write: if request.auth != null && request.auth.token.email.matches('.*@hashzone\\.(com|co\\.in)');
    }

    // ── Backup & Recovery ─────────────────────────────────────────────────
    match /backups/{docId} {
      allow read, write: if request.auth != null && request.auth.token.email.matches('.*@hashzone\\.(com|co\\.in)');
    }

    // ── Order Sub-Collections ───────────────────────────────────────────────
    match /orderAudit/{docId} {
      allow read, write: if request.auth != null && request.auth.token.email.matches('.*@hashzone\\.(com|co\\.in)');
    }
    match /dispatchInformation/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email.matches('.*@hashzone\\.(com|co\\.in)');
    }
    match /refundInformation/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email.matches('.*@hashzone\\.(com|co\\.in)');
    }

    // ── Connection Status / System Health ─────────────────────────────────
    match /connectionStatus/{docId} {
      allow read, write: if request.auth != null;
    }
    match /systemHealth/{docId} {
      allow read, write: if request.auth != null;
    }

  }
}
